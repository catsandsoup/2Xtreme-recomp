+void psx_engine_set_widescreen(int mode) {
+    int num = 4, den = 3;
+    if (mode == 1) { num = 16; den = 9; }
+    else if (mode == 2) { num = 21; den = 9; }
+    g_video_aspect_num = num;
+    g_video_aspect_den = den;
+    gl_renderer_set_display_aspect(num, den);
+    vk_renderer_set_display_aspect(num, den);
+    refresh_widescreen_projection();
+}
+
+int psx_engine_get_widescreen(void) {
+    if (g_video_aspect_num == 16 && g_video_aspect_den == 9) return 1;
+    if (g_video_aspect_num == 21 && g_video_aspect_den == 9) return 2;
+    return 0;
+}
+
+void psx_engine_set_resolution(int ir_preset) {
+    g_video_internal_res = ir_preset;
+    int scale = 1;
+    if (ir_preset == 720) scale = 3;
+    else if (ir_preset == 1080) scale = 4;
+    else if (ir_preset == 1440) scale = 6;
+    else if (ir_preset == 2160) scale = 9;
+    else if (ir_preset == -1) scale = 4;
+    g_video_scale = scale;
+    gr_set_scale(scale);
+}
+
+int psx_engine_get_resolution(void) {
+    return g_video_internal_res;
+}
+
+void psx_engine_set_fast_boot(int enabled) {
+    g_mac_fast_boot = (enabled != 0);
+}
+
+int psx_engine_get_fast_boot(void) {
+    return g_mac_fast_boot ? 1 : 0;
+}
+}
